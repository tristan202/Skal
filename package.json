{
  "name": "skal",
  "version": "0.3.0",
  "description": "Skal – en lille SSH-klient med faner og redigerbar serverliste",
  "author": "Allan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:zip": "electron-builder --win zip"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/xterm": "^5.5.0",
    "hash-wasm": "^4.12.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.5.0"
  },
  "build": {
    "appId": "dk.skal.sshclient",
    "productName": "Skal",
    "files": [
      "*.js",
      "renderer/**/*",
      "node_modules/**/*",
      "!**/*.map",
      "!**/*.md",
      "!**/*.d.ts",
      "!**/{test,tests,example,examples,docs}/**",
      "!node_modules/@xterm/*/src/**",
      "!node_modules/@xterm/*/typings/**",
      "!node_modules/{nan,buildcheck,cpu-features}/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "electronLanguages": [
      "da",
      "en-US"
    ],
    "compression": "maximum",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "ssh2@1.17.0": true,
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true
  }
}
