{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skal",
  "version": "../package.json",
  "identifier": "dk.skal.sshclient",
  "build": {
    "frontendDist": "../renderer",
    "beforeDevCommand": "node scripts/vendor.mjs",
    "beforeBuildCommand": "node scripts/vendor.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Skal",
        "width": 1280,
        "height": 800,
        "minWidth": 820,
        "minHeight": 500,
        "backgroundColor": "#171a26"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Allan",
    "copyright": "GPL-3.0-or-later",
    "category": "DeveloperTool",
    "shortDescription": "A small SSH client with tabs and an editable server list",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Danish"],
        "displayLanguageSelector": false
      }
    }
  }
}
